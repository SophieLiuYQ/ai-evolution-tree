---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const techs = await getCollection("techniques");

const CATEGORY_LABEL: Record<string, string> = {
  architecture: "Architectures",
  training: "Training",
  inference: "Inference & reasoning",
  capability: "Capabilities",
  scaling: "Scaling & data",
};
const CATEGORY_ORDER = ["architecture", "training", "inference", "capability", "scaling"];
const CATEGORY_HUE: Record<string, string> = {
  architecture: "#1f5f3f",
  training: "#7c3aed",
  inference: "#0369a1",
  capability: "#b45309",
  scaling: "#be185d",
};

const grouped = CATEGORY_ORDER.map((cat) => ({
  cat,
  label: CATEGORY_LABEL[cat],
  hue: CATEGORY_HUE[cat],
  items: techs
    .filter((t) => t.data.category === cat)
    .sort((a, b) => a.data.title.localeCompare(b.data.title)),
})).filter((g) => g.items.length > 0);
---

<Base
  title="Techniques · AI Evolution Tree"
  description="Plain-English explainers for the architectures, training methods, and inference techniques that power modern AI."
>
  <div class="tech-index-page">
    <header class="tech-index-hero">
      <h1>Techniques</h1>
      <p>
        Plain-English explainers for the architectures, training methods,
        and inference techniques behind the models in this tree. Built to
        help you read a model page and actually know what its specs mean.
      </p>
    </header>

    {grouped.map((g) => (
      <section class="tech-cat-section">
        <h2 class="tech-cat-heading" style={`--accent:${g.hue};`}>
          <span class="tech-cat-dot" aria-hidden="true"></span>
          {g.label}
          <span class="tech-cat-count">{g.items.length}</span>
        </h2>
        <div class="tech-cat-grid">
          {g.items.map((t) => (
            <a class="tech-card" href={`/technique/${t.data.slug}/`} style={`--accent:${g.hue};`}>
              <div class="tech-card-title">{t.data.title}</div>
              <p class="tech-card-line">{t.data.one_liner}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

<style>
  .tech-index-page {
    max-width: 64rem;
    margin: 0 auto;
    padding: 16px 0 80px 0;
  }
  .tech-index-hero {
    padding: 24px 0 28px 0;
    border-bottom: 1px solid var(--border, #e2e8f0);
    margin-bottom: 28px;
  }
  .tech-index-hero h1 {
    margin: 0 0 12px 0;
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .tech-index-hero p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--fg-muted, #475569);
    max-width: 60ch;
  }
  .tech-cat-section {
    margin-bottom: 36px;
  }
  .tech-cat-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px 0;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-muted, #475569);
  }
  .tech-cat-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .tech-cat-count {
    margin-left: auto;
    color: var(--fg-muted, #94a3b8);
    font-size: 12px;
    font-weight: 700;
  }
  .tech-cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }
  .tech-card {
    display: block;
    padding: 16px 18px;
    border: 1px solid var(--border, #e2e8f0);
    border-radius: 12px;
    background: var(--bg-soft, #fff);
    text-decoration: none;
    color: var(--fg, #0f172a);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    border-left: 3px solid var(--accent);
  }
  .tech-card:hover {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border, #e2e8f0));
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
  }
  .tech-card-title {
    font-size: 16px;
    font-weight: 750;
    line-height: 1.3;
    margin-bottom: 6px;
  }
  .tech-card-line {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--fg-muted, #475569);
  }
</style>
